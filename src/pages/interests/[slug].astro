---
import type { MarkdownInstance } from "astro";
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import HeroFigure from "../../components/HeroFigure.astro";
import Lightbox from "../../components/Lightbox.astro";
import { galleries } from "../../data/galleries";

interface Frontmatter {
  title: string;
  summary: string;
  detailsHref?: string;
  detailsLabel?: string;
  gallery?: string;
  heroPosition?: "before" | "after";
}

export function getStaticPaths() {
  const files = import.meta.glob<MarkdownInstance<Frontmatter>>("../../content/interests/*.md", { eager: true });
  return Object.entries(files).map(([path, entry]) => ({
    params: { slug: path.split("/").pop()!.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, frontmatter } = entry;
const gallery = frontmatter.gallery ? galleries[frontmatter.gallery] : undefined;
const heroPosition = frontmatter.heroPosition ?? "before";
---

<Base title={frontmatter.title} description={frontmatter.summary}>
  <p class="back"><a href="/interests/">← Other interests</a></p>
  <h1>{frontmatter.title}</h1>
  <p class="lead">{frontmatter.summary}</p>
  {gallery && heroPosition === "before" && <HeroFigure gallery={gallery} />}
  <div class="prose">
    <Content />
  </div>
  {gallery && heroPosition === "after" && <HeroFigure gallery={gallery} />}
  {
    gallery && gallery.items.length > 0 && (
      <section class="photos">
        <h2>Image Gallery</h2>
        <Gallery folder={gallery.folder} items={gallery.items} />
      </section>
    )
  }
  {
    frontmatter.detailsHref && (
      <p class="more">
        <a class="button" href={frontmatter.detailsHref}>
          {frontmatter.detailsLabel ?? "See the details"} →
        </a>
      </p>
    )
  }
  {gallery && <Lightbox />}
</Base>
