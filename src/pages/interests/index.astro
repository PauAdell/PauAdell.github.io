---
import Base from "../../layouts/Base.astro";

interface Frontmatter {
  title: string;
  summary: string;
  order?: number;
}

const files = import.meta.glob<{ frontmatter: Frontmatter; url: string }>("../../content/interests/*.md", {
  eager: true,
});

const interests = Object.entries(files)
  .map(([path, mod]) => ({ slug: path.split("/").pop()!.replace(/\.md$/, ""), ...mod.frontmatter }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<Base title="Other interests">
  <h1>Other interests</h1>
  <p class="lead">Things I build when I'm not writing software for a living.</p>
  <div class="about">
    <p>
      I’m driven by understanding how things work from the ground up, which means my curiosity rarely stops at software. 
      I love working with physical hardware: what started with repairing phones, tinkering with electronics, and playing with 
      Arduinos eventually turned into engineering a custom home powerwall that stores solar energy and keeps our house 
      off-grid through summer.
    </p>
    <p>
      I like keeping one foot in the digital world and one in the physical. Right now, that looks like diving into computer 
      graphics on the screen while rebuilding my dad’s 50-year-old Vespa in the garage bringing it back to life. 
      That just happens to be today's obsession, though; I don’t really draw lines between software, mechanics, 
      or any other field; tomorrow it could be an entirely different puzzle, as long as there’s something complex to break down and master.
    </p>
    <p>
      Also, I like rockets.
    </p>
  </div>
  <ul class="list">
    {
      interests.map((i) => (
        <li>
          <a href={`/interests/${i.slug}/`}>{i.title}</a>
          <p>{i.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>
