---
import Base from "../layouts/Base.astro";
import { site } from "../config";

interface ExperienceFrontmatter {
  title: string;
  company: string;
  period: string;
  summary: string;
  order?: number;
}

const experienceFiles = import.meta.glob<{ frontmatter: ExperienceFrontmatter }>("../content/experience/*.md", {
  eager: true,
});

const currentRole = Object.values(experienceFiles)
  .map((mod) => mod.frontmatter)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))[0];
---

<Base>
  <h1>{site.tagline}</h1>
  <p class="lead">{site.intro}</p>
  <div class="about">{site.about.slice(0, -1).map((text) => <p>{text}</p>)}</div>

  <h2>Experience</h2>
  <p>
    {currentRole.title} at {currentRole.company} ({currentRole.period}). {currentRole.summary}
  </p>
  <p><a href="/experience/">More on my experience &rarr;</a></p>

  <h2>Software projects</h2>
  <div class="about">{site.about.slice(-1).map((text) => <p>{text}</p>)}</div>
  <p><a href="/projects/">More on my software projects &rarr;</a></p>
</Base>
