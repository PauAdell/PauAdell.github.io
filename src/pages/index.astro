---
import Base from "../layouts/Base.astro";
import { site } from "../config";
import { publications } from "../data/publications";

interface Frontmatter {
  title: string;
  summary: string;
  order?: number;
}

const files = import.meta.glob<{ frontmatter: Frontmatter }>("../content/projects/*.md", { eager: true });

const projects = Object.entries(files)
  .map(([path, mod]) => ({ repo: path.split("/").pop()!.replace(/\.md$/, ""), ...mod.frontmatter }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<Base>
  <h1>{site.tagline}</h1>
  <p class="lead">{site.intro}</p>
  <div class="about">{site.about.map((text) => <p>{text}</p>)}</div>

  <h2>Software projects</h2>
  <ul class="list">
    {
      projects.map((p) => (
        <li>
          <a href={`/projects/${p.repo}/`}>{p.title}</a>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>

  <h2>Theses &amp; publications</h2>
  <ul class="list">
    {
      publications.map((p) => (
        <li>
          {p.url ? <a href={p.url}>{p.title}</a> : <span class="title">{p.title}</span>}
          <p class="meta">{p.meta}</p>
          <p>{p.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>
